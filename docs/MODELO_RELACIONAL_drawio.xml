        <!-- Cuadro Informativo de Normalización y Notación de Codd -->
        <mxCell id="mr_notes" value="&lt;b style=&quot;color: #38bdf8; font-size: 13px;&quot;&gt;JUSTIFICACIÓN CIENTÍFICA DE NORMALIZACIÓN Y ESQUEMA DE CODD:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color: #ffffff;&quot;&gt;Notación Formal de Codd:&lt;/b&gt; &lt;br&gt;  USUARIOS(&lt;u&gt;id&lt;/u&gt;, nombre, email&lt;sup&gt;UK&lt;/sup&gt;, password, cuit, telefono, rubro, ciudad, provincia, direccion, rol, estado, created_at, updated_at, ultimo_login)&lt;br&gt;  PRODUCTOS(&lt;u&gt;id&lt;/u&gt;, user_id&lt;sup&gt;FK&lt;/sup&gt;, nombre, tipo_polimero, cantidad_kg, precio_unitario, ubicacion, descripcion, estado, created_at, updated_at)&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color: #ffffff;&quot;&gt;1FN (Primera Forma Normal):&lt;/b&gt; Dominios atómicos indivisibles; el atributo compuesto de localización se dividió en direccion, ciudad y provincia.&lt;br&gt;• &lt;b style=&quot;color: #ffffff;&quot;&gt;2FN (Segunda Forma Normal):&lt;/b&gt; Demostrado por el &lt;i&gt;Teorema de Clave Simple&lt;/i&gt;. Al tener claves primarias atómicas simples (id), es imposible la existencia de dependencias parciales.&lt;br&gt;• &lt;b style=&quot;color: #ffffff;&quot;&gt;3FN y FNBC (Tercera Forma Normal y Boyce-Codd):&lt;/b&gt; No existen dependencias transitivas. Los datos de la empresa no se duplican en productos y se resuelven puramente mediante JOIN. En toda DF no trivial X → Y, el determinante X es superclave." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#1e293b;align=left;verticalAlign=top;spacing=14;fontColor=#cbd5e1;fontSize=11;" vertex="1" parent="mr_1">
